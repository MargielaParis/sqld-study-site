{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "replace-with-worker-name",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "SQLD_DOCS",
      "id": "replace-with-kv-namespace-id"
    }
  ],
  "observability": {
    "enabled": true
  }
}
